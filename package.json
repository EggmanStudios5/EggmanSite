{
  "name": "eggman-studios-web",
  "version": "1.0.0",
  "description": "Eggman Studios foundational open-source landing page and solutions hub built on Mateo's WEB-Projekt design system.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "dev": "node scripts/build.mjs && python3 -m http.server 8000",
    "scan:repos": "node scripts/scan-repos.mjs",
    "build": "node scripts/build.mjs",
    "build:css": "tailwindcss -i src/css/input.css -o src/css/style.css",
    "watch:css": "tailwindcss -i src/css/input.css -o src/css/style.css --watch",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/build.mjs && node scripts/verify.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FilipVastl005/WEB-Projekt.git"
  },
  "keywords": [
    "eggman-studios",
    "open-source",
    "sovereign-software",
    "rfid-access-control",
    "macro-pad",
    "mateo-weather"
  ],
  "author": "Eggman Studios / Filip Vastl",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}


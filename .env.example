# Eggman Platform — Root Environment Template (Placeholders ONLY — NEVER commit real .env)
# Copy to .env on the EliteDesk with 0600 permissions; secrets belong in HashiCorp Vault.

EGGMAN_DOMAIN=eggmanstudios.me
EGGMAN_ORG=EggmanStudios5

# Network Interfaces (populated by bootstrap-elitedesk.sh / Ansible)
TAILSCALE_IP=100.64.0.10
IOT_VLAN_IP=192.168.50.10
IOT_VLAN_CIDR=192.168.50.0/24
EGGMAN_ADMIN_USER=eggman-ops

# Host Storage Root (created with strict 0750/0600 permissions by Ansible)
EGGMAN_DATA_ROOT=/srv/eggman/data
EGGMAN_SECRETS_ROOT=/srv/eggman/secrets
EGGMAN_CERTS_ROOT=/srv/eggman/certs
EGGMAN_RELEASES_ROOT=/srv/eggman/releases

# Cloudflare Tunnel (Zone A Public DMZ only — obtain token via Cloudflare Zero Trust dashboard)
CLOUDFLARED_TUNNEL_TOKEN=CHANGE_ME_FROM_VAULT_CF_TUNNEL_TOKEN

# Container Image Registry Tags (pinned)
DOTNET_IMAGE_TAG=9.0

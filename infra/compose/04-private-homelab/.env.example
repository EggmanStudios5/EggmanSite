# 04-private-homelab/.env.example — Populate from Vault; never commit real .env
EGGMAN_DATA_ROOT=/srv/eggman/data
EGGMAN_CERTS_ROOT=/srv/eggman/certs
EGGMAN_SECRETS_ROOT=/srv/eggman/secrets
IOT_VLAN_IP=192.168.50.10
RENDER_GID=109

NEXTCLOUD_DB_PASSWORD=CHANGE_ME_FROM_VAULT_NEXTCLOUD_DB_PASS
NEXTCLOUD_ADMIN_USER=eggman-nc-admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_FROM_VAULT_NEXTCLOUD_ADMIN
NEXTCLOUD_REDIS_PASSWORD=CHANGE_ME_FROM_VAULT_REDIS_NC_PASS

IMMICH_DB_PASSWORD=CHANGE_ME_FROM_VAULT_IMMICH_DB_PASS
IMMICH_REDIS_PASSWORD=CHANGE_ME_FROM_VAULT_REDIS_IMMICH_PASS

FORGEJO_DB_PASSWORD=CHANGE_ME_FROM_VAULT_FORGEJO_DB_PASS
IOT_DEVICE_HMAC_SECRET=CHANGE_ME_FROM_VAULT_IOT_HMAC_SECRET

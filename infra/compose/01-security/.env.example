# 01-security/.env.example — Populate from Vault before running; never commit .env
TAILSCALE_IP=100.64.0.10
EGGMAN_DATA_ROOT=/srv/eggman/data
EGGMAN_CERTS_ROOT=/srv/eggman/certs

KC_DB_PASSWORD=CHANGE_ME_FROM_VAULT_KEYCLOAK_DB_PASS
KEYCLOAK_ADMIN=eggman-sec-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_FROM_VAULT_KEYCLOAK_ADMIN_PASS
CLOUDFLARE_DNS_API_TOKEN=CHANGE_ME_FROM_VAULT_CF_DNS01_TOKEN

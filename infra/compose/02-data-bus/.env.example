# 02-data-bus/.env.example — Populate from Vault before running; never commit .env
EGGMAN_DATA_ROOT=/srv/eggman/data
EGGMAN_SECRETS_ROOT=/srv/eggman/secrets
EGGMAN_CERTS_ROOT=/srv/eggman/certs

POSTGRES_PUBLIC_ADMIN_PASSWORD=CHANGE_ME_FROM_VAULT_PG_PUB_ADMIN
KC_DB_PASSWORD=CHANGE_ME_FROM_VAULT_KEYCLOAK_DB_PASS
RELEASEHUB_DB_PASSWORD=CHANGE_ME_FROM_VAULT_RELEASEHUB_DB_PASS
VAULT_PG_PUB_PASSWORD=CHANGE_ME_FROM_VAULT_PG_PUB_DYNAMIC

POSTGRES_PRIVATE_ADMIN_PASSWORD=CHANGE_ME_FROM_VAULT_PG_PRIV_ADMIN
NEXTCLOUD_DB_PASSWORD=CHANGE_ME_FROM_VAULT_NEXTCLOUD_DB_PASS
IMMICH_DB_PASSWORD=CHANGE_ME_FROM_VAULT_IMMICH_DB_PASS
FORGEJO_DB_PASSWORD=CHANGE_ME_FROM_VAULT_FORGEJO_DB_PASS
IOT_BRIDGE_DB_PASSWORD=CHANGE_ME_FROM_VAULT_IOT_DB_PASS
VAULT_PG_PRIV_PASSWORD=CHANGE_ME_FROM_VAULT_PG_PRIV_DYNAMIC

# REDIS_HEALTH_PASSWORD removed: runtime healthcheck reads /srv/eggman/secrets/redis/health.pass rendered by bootstrap-vault.sh
RABBITMQ_ERLANG_COOKIE=CHANGE_ME_FROM_VAULT_RMQ_COOKIE

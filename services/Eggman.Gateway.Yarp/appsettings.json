{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Keycloak": {
    "Authority": "https://auth.eggmanstudios.me/realms/eggman-public",
    "MetadataAddress": "https://eggman-keycloak:8443/realms/eggman-public/.well-known/openid-configuration",
    "Audience": "eggman-releasehub"
  },
  "ReverseProxy": {
    "Routes": {
      "landing-route": {
        "ClusterId": "landing-cluster",
        "RateLimiterPolicy": "public-web",
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "X-Real-IP" },
          { "RequestHeaderRemove": "X-Forwarded-For" },
          { "RequestHeaderRemove": "X-Forwarded-User" },
          { "RequestHeaderRemove": "X-Remote-User" },
          { "RequestHeaderRemove": "X-Auth-User" },
          { "RequestHeaderRemove": "X-Original-URL" },
          { "RequestHeaderRemove": "X-Rewrite-URL" }
        ],
        "Match": {
          "Hosts": [ "eggmanstudios.me", "www.eggmanstudios.me" ],
          "Methods": [ "GET", "HEAD" ],
          "Path": "{**catch-all}"
        }
      },
      "docs-route": {
        "ClusterId": "docs-cluster",
        "RateLimiterPolicy": "public-web",
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "X-Real-IP" },
          { "RequestHeaderRemove": "X-Forwarded-For" },
          { "RequestHeaderRemove": "X-Forwarded-User" },
          { "RequestHeaderRemove": "X-Remote-User" },
          { "RequestHeaderRemove": "X-Auth-User" },
          { "RequestHeaderRemove": "X-Original-URL" },
          { "RequestHeaderRemove": "X-Rewrite-URL" }
        ],
        "Match": {
          "Hosts": [ "docs.eggmanstudios.me" ],
          "Methods": [ "GET", "HEAD" ],
          "Path": "{**catch-all}"
        }
      },
      "releasehub-read-route": {
        "ClusterId": "releasehub-cluster",
        "RateLimiterPolicy": "public-api",
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "X-Real-IP" },
          { "RequestHeaderRemove": "X-Forwarded-For" },
          { "RequestHeaderRemove": "X-Forwarded-User" },
          { "RequestHeaderRemove": "X-Remote-User" },
          { "RequestHeaderRemove": "X-Auth-User" }
        ],
        "Match": {
          "Hosts": [ "releases.eggmanstudios.me", "altstore.eggmanstudios.me" ],
          "Methods": [ "GET", "HEAD" ],
          "Path": "{**catch-all}"
        }
      },
      "releasehub-write-route": {
        "ClusterId": "releasehub-cluster",
        "AuthorizationPolicy": "ReleaseWritePolicy",
        "RateLimiterPolicy": "public-api",
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "X-Real-IP" },
          { "RequestHeaderRemove": "X-Forwarded-For" },
          { "RequestHeaderRemove": "X-Forwarded-User" },
          { "RequestHeaderRemove": "X-Remote-User" },
          { "RequestHeaderRemove": "X-Auth-User" }
        ],
        "Match": {
          "Hosts": [ "releases.eggmanstudios.me" ],
          "Methods": [ "POST", "PUT", "DELETE" ],
          "Path": "/api/v1/releases/{**catch-all}"
        }
      },
      "releasehub-upload-route": {
        "ClusterId": "releasehub-cluster",
        "AuthorizationPolicy": "ReleasePublishPolicy",
        "RateLimiterPolicy": "public-api",
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "X-Real-IP" },
          { "RequestHeaderRemove": "X-Forwarded-For" },
          { "RequestHeaderRemove": "X-Forwarded-User" },
          { "RequestHeaderRemove": "X-Remote-User" },
          { "RequestHeaderRemove": "X-Auth-User" }
        ],
        "Match": {
          "Hosts": [ "releases.eggmanstudios.me" ],
          "Methods": [ "POST", "PUT" ],
          "Path": "/api/releases/{**catch-all}"
        }
      },
      "auth-public-realm-route": {
        "ClusterId": "keycloak-cluster",
        "RateLimiterPolicy": "auth-strict",
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "X-Real-IP" },
          { "RequestHeaderRemove": "X-Forwarded-For" },
          { "RequestHeaderRemove": "X-Forwarded-User" },
          { "RequestHeaderRemove": "X-Remote-User" }
        ],
        "Match": {
          "Hosts": [ "auth.eggmanstudios.me" ],
          "Path": "/realms/eggman-public/{**catch-all}"
        }
      },
      "auth-public-assets-route": {
        "ClusterId": "keycloak-cluster",
        "RateLimiterPolicy": "public-web",
        "Match": {
          "Hosts": [ "auth.eggmanstudios.me" ],
          "Methods": [ "GET", "HEAD" ],
          "Path": "/resources/{**catch-all}"
        }
      },
      "status-public-page-route": {
        "ClusterId": "status-cluster",
        "RateLimiterPolicy": "public-web",
        "Match": {
          "Hosts": [ "status.eggmanstudios.me" ],
          "Methods": [ "GET", "HEAD" ],
          "Path": "/status/{**catch-all}"
        }
      },
      "status-public-api-route": {
        "ClusterId": "status-cluster",
        "RateLimiterPolicy": "public-web",
        "Match": {
          "Hosts": [ "status.eggmanstudios.me" ],
          "Methods": [ "GET", "HEAD" ],
          "Path": "/api/status-page/{**catch-all}"
        }
      },
      "status-public-assets-route": {
        "ClusterId": "status-cluster",
        "RateLimiterPolicy": "public-web",
        "Match": {
          "Hosts": [ "status.eggmanstudios.me" ],
          "Methods": [ "GET", "HEAD" ],
          "Path": "/assets/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "landing-cluster": {
        "Destinations": {
          "landing": { "Address": "http://eggman-web-landing:8080/" }
        }
      },
      "docs-cluster": {
        "Destinations": {
          "docs": { "Address": "http://eggman-web-docs:8080/" }
        }
      },
      "releasehub-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:05:00"
        },
        "Destinations": {
          "releasehub": { "Address": "https://eggman-releasehub:8443/" }
        }
      },
      "keycloak-cluster": {
        "Destinations": {
          "keycloak": { "Address": "https://eggman-keycloak:8443/" }
        }
      },
      "status-cluster": {
        "Destinations": {
          "uptime-kuma": { "Address": "http://eggman-uptime-kuma:3001/" }
        }
      }
    }
  }
}
